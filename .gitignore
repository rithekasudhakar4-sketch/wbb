# ==============================================================================
# Nalam Nagar Emergency Dispatch - .gitignore
# ==============================================================================

# --- Java Build Artifacts ---
bin/
*.class
target/
build/
out/
dist/

# --- JAR Archives (Ignore general jars, but keep required dependencies in lib/) ---
*.jar
*.war
*.ear
!lib/*.jar

# --- Database & Runtime Files ---
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- Sensitive Environment & Secrets ---
.env
.env.*
*.env
*.key
*.pem
*.pfx

# --- Logs & Crash Dumps ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
hs_err_pid*.log
replay_pid*.log

# --- Operating System Files ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# --- IDE & Editor Files ---
.idea/
*.iml
*.ipr
*.iws
.settings/
.vscode/*
!.vscode/settings.json
